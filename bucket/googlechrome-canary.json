        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/jsk4hggnouyqn42jeugiydwnfy_155.0.8052.0/155.0.8052.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "042b644b46af9e6bec60cd75ff90a805420d718f1886d38634ce34a1a17d0cf2"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adycpeftdhmg7it5q2d3i4bwxbuq_155.0.8052.1/155.0.8052.1_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "174c46bb30011a23bae6599d4404499ca3351f85800759008882302ffc66fe45"
